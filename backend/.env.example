# Copy to .env. Everything here is optional — the pipeline runs without any of it.

# Set to 1 to skip TimesFM entirely (laptop dev, or if the checkpoint misbehaves).
# The pipeline falls back to baselines and /health reports why.
DISABLE_TIMESFM=

TIMESFM_CHECKPOINT=google/timesfm-3.0-pytorch
TIMESFM_DEVICE=cuda
TIMESFM_BATCH_SIZE=16

# Without this, alerts return the payload instead of sending — demo still works offline.
SLACK_WEBHOOK_URL=

DATA_DIR=
