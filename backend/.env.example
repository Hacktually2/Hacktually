# Remote GPU inference service — TimesFM and TiRex-2 live behind this one endpoint.
# Without these the pipeline still runs end to end on baselines plus the calendar
# wrapper; the router just drops the foundation models.
GPU_INFERENCE_URL=
GPU_INFERENCE_API_KEY=

# Tuning. The service takes one series per call, so concurrency is what keeps a
# backtest from becoming dead air on stage. Raise cautiously — the GPU box has to
# absorb it.
GPU_MAX_WORKERS=8
GPU_TIMEOUT=300
GPU_PROBE_TIMEOUT=20
GPU_MAX_CONTEXT=2048

# Slack alerts. Unset means the API returns the message instead of sending it,
# so the demo works offline.
SLACK_WEBHOOK_URL=

# Where SQLite and uploads live. Defaults to <repo>/data.
# DATA_DIR=

# Demo insurance. With GPU_OFFLINE=1 a dead tunnel no longer removes the
# foundation models from the router — cached responses from the last successful
# run are served instead. Only switch on when the cache was built on the dataset
# you are demoing.
GPU_OFFLINE=
GPU_CACHE=1

# A failed probe expires after this many seconds instead of being trusted for
# the life of the process — one tunnel hiccup should not remove the foundation
# models until restart. Transient transport errors are also retried.
GPU_RECHECK_SECONDS=60
GPU_RETRIES=2

# ----------------------------------------------------------- access control
# A shared key, not authentication. Identity and branch permissions live in the
# frontend's auth layer; this service only refuses anything that is not the
# app's own server.
#
# Unset means OPEN, which is fine only while nothing outside this host can
# reach the port. The startup log warns on every boot when it is unset. Set it
# before deploying anywhere a browser can reach.
#   openssl rand -base64 32
BACKEND_API_KEY=

# With a key set, every request must also declare X-Tenant-Id, and a dataset
# belonging to another tenant answers 404 — not 403, because confirming that an
# id exists is itself a disclosure. Set to 0 for a single-tenant deployment.
BACKEND_REQUIRE_TENANT=1

# ------------------------------------------------------------ email digests
# Unset means the digest endpoint returns the message instead of sending it, so
# the flow can be demonstrated without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
