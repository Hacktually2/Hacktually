# ---------------------------------------------------------------- auth layer
# Signs the session cookie. Optional in development: without it, a key is
# generated on first run and kept in data/auth.db. Set it in production, and
# rotating it signs everyone out.
#   openssl rand -base64 32
AUTH_SECRET=

# Where the auth database and uploads live. Defaults to ./data
# AUTH_DATA_DIR=

# -------------------------------------------------------- forecasting backend
# The FastAPI service in backend/. Server-side only: it has no auth of its own,
# so the browser must never hold its address. Every call is proxied through a
# Server Component or Server Action that has already checked branch access.
BACKEND_API_URL=http://localhost:8000

# How long to wait for it. Confirming a mapping reads the whole file, so this
# is deliberately generous.
# BACKEND_TIMEOUT_MS=15000

# ----------------------------------------------------------------- assistant
# The in-app assistant ("Ask the data"). Without it the panel still opens and
# says it is not configured; nothing else breaks. Server-side only.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- demo aids
# Adds artificial latency to the data layer so loading skeletons are visible.
# DEMO_LATENCY_MS=600

# ------------------------------------------------------ GPU inference service
# Read by the Python backend, never by Next.js. The backend loads backend/.env
# first and falls back to this file, so either location works.
#
# TimesFM and TiRex-2 are served behind this one endpoint. The URL changes every
# time the tunnel restarts — run `py -3.11 backend/scripts/check_gpu.py` after
# updating it. Without these the backend still runs end to end on baselines.
#
# Full tuning options (workers, retries, offline cache) are documented in
# backend/.env.example.
GPU_INFERENCE_URL=
GPU_INFERENCE_API_KEY=
